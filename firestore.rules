rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isRegisteredUser() {
      return isSignedIn() && !isAnonymous();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function postPath(postId) {
      return /databases/$(database)/documents/posts/$(postId);
    }

    function isPostOwner(postId) {
      return isSignedIn()
        && exists(postPath(postId))
        && get(postPath(postId)).data.userId == request.auth.uid;
    }

    // Shared word list
    match /words/{wordId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isRegisteredUser();
    }

    // Per-user private data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community categories are shared read-only seed data for now.
    match /boardCategories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Community posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      // Comments under a post
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.userId == request.auth.uid;
        allow update: if isSignedIn()
          && resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn()
          && (
            resource.data.userId == request.auth.uid
            || isPostOwner(postId)
          );
      }

      // One-like-per-user using the uid as document id.
      match /likes/{userId} {
        allow read: if isSignedIn();
        allow create: if isOwner(userId)
          && request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(userId) || isPostOwner(postId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
