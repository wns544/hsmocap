rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    function isRegisteredUser() {
      return isSignedIn() && !isAnonymous();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Shared word list
    match /words/{wordId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isRegisteredUser();
    }

    // Per-user private data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Community content
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isRegisteredUser();
      allow update, delete: if isRegisteredUser() && resource.data.authorId == request.auth.uid;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
